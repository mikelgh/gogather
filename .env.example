# ── 飞猪 AI 开放平台 API Key（可选） ──
# 体验模式（不填）也能跑，但部分结果受限；正式解锁完整服务去控制台获取：
# https://flyai.open.fliggy.com/console
FLYAI_API_KEY=

# ── 阿里云百炼 / 通义千问 API Key（可选） ──
# 不填则方案用模板拼接，填了用 Qwen 润色成结构化方案。
# 大赛送百炼新用户 1 亿 Token：https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=

# 百炼模型名（默认 qwen-plus）
QWEN_MODEL=qwen-plus

# ── MiniMax API Key（可选，LLM_PROVIDER=minimax 时启用）──
# 实测 MiniMax-M3 关闭思考后比 qwen-plus 快约 2.5 倍
# 申请地址：https://platform.minimaxi.com
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn/v1
MINIMAX_MODEL=MiniMax-M3

# LLM 供应商选择：qwen（默认）或 minimax
LLM_PROVIDER=qwen

# 可选：JWT 签名密钥（部署到公网时务必修改，否则用内置开发默认值）
JWT_SECRET=

# ── GitHub OAuth（可选，启用后用户可用 GitHub 账号登录）──
# 创建 OAuth App: https://github.com/settings/developers
# Callback URL: https://你的域名/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://gogather.partystack.cn/api/auth/github/callback

# 可选：直接指定 flyai 可执行文件路径；缺省自动探测 node_modules/.bin/flyai 或回退 npx
FLYAI_BIN=

# ── 阿里云验证码 2.0（可选，启用后注册需过人机验证）──
# 控制台: https://yundun.console.aliyun.com/?p=captcha （或控制台搜索"验证码2.0"）创建验证场景拿 SceneId
# RAM 子账号需授权 AliyunCaptchaFullAccess；三个都填了才启用
ALIYUN_CAPTCHA_PREFIX=          # 身份标：控制台"概览"页实例基本信息卡片
ALIYUN_CAPTCHA_SCENE_ID=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_CAPTCHA_REGION=cn-shanghai

# ── 支付宝 OAuth（可选，启用后用户可用支付宝账号登录）──
# 创建应用: https://open.alipay.com → 网页&移动应用 → 添加"用户信息授权"功能
# Callback URL: https://你的域名/api/auth/alipay/callback
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_CALLBACK_URL=https://gogather.partystack.cn/api/auth/alipay/callback
